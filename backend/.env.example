# Copie este arquivo para .env e configure a conexão no seu computador.
# Nunca coloque credenciais reais neste arquivo de exemplo.
MONGODB_URI=mongodb://127.0.0.1:27017/medtrack
# Para Atlas, substitua a linha acima usando seus próprios dados:
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/medtrack
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
